# Optional full backend example (not required for normal use).
# Prefer: keep terraform/backend.tf as-is and pass bucket at init time:
#   terraform init -backend-config="bucket=<your-state-bucket>"
#
#   cp backend.tf.example backend.tf   # if replacing the committed backend locally
#   # Edit bucket/prefix, create bucket + versioning (see README).
#   terraform init -migrate-state -backend-config="bucket=<your-state-bucket>"
#
# Omit backend block for default local state (terraform.tfstate in this directory).

terraform {
  backend "gcs" {
    bucket = "YOUR_UNIQUE_TF_STATE_BUCKET"
    prefix = "digital-twin/terraform"
  }
}

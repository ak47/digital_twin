# Copy to `terraform.tfvars` (gitignored) — do not commit.
#
# After apply: ../scripts/print-github-actions-secrets.sh → paste into GitHub Actions secrets.
# Details: README.md in this directory.
#
# project_id = "your-gcp-project-id"
# github_repository = "your-github-org/digital_twin"   # required for GitHub Actions WIF (see variables.tf default "")
# region     = "us-central1"
#
# Required (no default in variables.tf):
# cors_allowed_origins = ["https://your-frontend.example", "https://www.your-frontend.example"]
#
# Optional overrides:
# name_prefix            = "digital-twin"
# RAG Engine: SPANNER_BASIC (default) | SPANNER_SCALED | SERVERLESS (no Terraform RAG config resource; see README)
# rag_engine_deployment_mode = "SERVERLESS"
# rag_corpus_ingest_region = "europe-west4"   # backup if RAG in var.region is allowlist-blocked (must be "" if SERVERLESS)
# session_retention_days = 3
# cloud_run_custom_domain = "api.example.com"   # optional; verify the base domain in GCP first
# rag_corpus_resource_name = "projects/your-project/locations/us-central1/ragCorpora/your-corpus-id"
#
# Same bucket name as terraform/backend.tf — Ingest RAG + terraform.yml need remote state access:
# gha_terraform_state_bucket = "your-terraform-state-bucket"
#
# Let GitHub Actions run terraform plan/apply (.github/workflows/terraform.yml); bootstrap with one local apply:
# github_actions_terraform_roles = ["roles/editor", "roles/resourcemanager.projectIamAdmin"]
#
# Teardown / project migration only (deletes bucket contents with the bucket):
# bucket_force_destroy = true

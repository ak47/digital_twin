# Copy to `terraform.tfvars` (gitignored) — do not commit.
#
# After apply: ../scripts/print-github-actions-secrets.sh → paste into GitHub Actions secrets.
# Details: README.md in this directory.
#
# project_id = "your-gcp-project-id"
# github_repository = "ak47/digital_twin"   # default in variables.tf; override only for forks / no WIF
# region     = "us-central1"
#
# Optional overrides:
# name_prefix            = "digital-twin"
# rag_engine_tier        = "BASIC"
# rag_corpus_ingest_region = "europe-west4"   # backup if RAG in var.region (us-central1) is allowlist-blocked
# session_retention_days = 3
# cors_allowed_origins   = ["https://no-ego.net", "https://www.no-ego.net"]
# cloud_run_custom_domain = "digital-twin.no-ego.net"   # optional; verify no-ego.net for GCP first
# rag_corpus_resource_name = "projects/your-project/locations/us-central1/ragCorpora/your-corpus-id"
#
# Teardown / project migration only (deletes bucket contents with the bucket):
# bucket_force_destroy = true

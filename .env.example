# Copy to `.env` (gitignored) for local runs. Load before Terraform: `set -a && source .env && set +a`
# (or use direnv). FastAPI does not auto-load this file unless you use a tool that exports env.

GCP_PROJECT_ID=
# Optional: override default region for local tooling
GCP_REGION=us-central1

# Browser origins when testing CORS locally (comma-separated). If unset, only localhost dev origins apply.
# CORS_ALLOWED_ORIGINS=https://localhost:8000,http://localhost:8000

# Vertex Gemini (uses ADC on Cloud Run; locally use gcloud auth application-default login)
# GEMINI_MODEL=gemini-2.5-flash
# Lower temperature reduces creative filler; default in code is 0.2 if unset.
# GEMINI_TEMPERATURE=0.2
# MAX_OUTPUT_TOKENS=1024
# SYSTEM_PROMPT_PATH=/absolute/path/to/system.md

# Optional: omit to use in-memory sessions locally
# GCS_SESSIONS_BUCKET=

# RATE_LIMIT_REQUESTS_PER_MINUTE=30

# RAG — Terraform reads this name (maps to variable rag_corpus_resource_name → Cloud Run RAG_CORPUS_RESOURCE):
# TF_VAR_rag_corpus_resource_name=projects/PROJECT/locations/us-central1/ragCorpora/CORPUS_ID
#
# Local uvicorn (export manually or use `set -a && source .env` before starting):
# RAG_CORPUS_RESOURCE=projects/PROJECT/locations/us-central1/ragCorpora/CORPUS_ID
# RAG_TOP_K=8

# Crash data (BigQuery) — set by Terraform as CRASH_DATA_BQ_DATASET when enable_crash_data=true
# CRASH_DATA_BQ_DATASET=vehicle_crashes
